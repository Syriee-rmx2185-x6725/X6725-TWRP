# mount point  fstype  device  flags (TWRP format) -- converted from stock recovery.fstab
/system_root   ext4   system   flags=display="System";logical;slotselect
/system_ext    ext4   system_ext   flags=display="System_ext";logical;slotselect
/vendor        ext4   vendor   flags=display="Vendor";logical;slotselect
/product       ext4   product   flags=display="Product";logical;slotselect
/odm           ext4   odm   flags=display="Odm";logical;slotselect
/vendor_dlkm   ext4   vendor_dlkm   flags=display="Vendor_dlkm";logical;slotselect
/system_dlkm   ext4   system_dlkm   flags=display="System_dlkm";logical;slotselect
/data          f2fs   /dev/block/by-name/userdata   flags=fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized;keydirectory=/metadata/vold/metadata_encryption;metadata_encryption=aes-256-xts:wrappedkey_v0
/metadata      f2fs   /dev/block/by-name/metadata   flags=display="Metadata"
/cache         f2fs   /dev/block/by-name/cache   flags=display="Cache"
/tranfs        ext4   /dev/block/by-name/tranfs   flags=display="Tranfs"
/persist       ext4   /dev/block/by-name/persist   flags=display="Persist"
/misc          emmc   /dev/block/by-name/misc
/miscdata      emmc   /dev/block/by-name/miscdata   flags=backup=1
/boot          emmc   /dev/block/by-name/boot   flags=display="Boot";backup=1;flashimg=1;slotselect
/vendor_boot   emmc   /dev/block/by-name/vendor_boot   flags=display="Vendor_boot";backup=1;flashimg=1;slotselect
/dtbo          emmc   /dev/block/by-name/dtbo   flags=display="Dtbo";backup=1;flashimg=1;slotselect
/vbmeta        emmc   /dev/block/by-name/vbmeta   flags=display="Vbmeta";backup=1;flashimg=1;slotselect
/sdcard1       vfat   /dev/block/mmcblk1p1   flags=display="MicroSD";storage;wipeingui;removable
/usb_otg       auto   /dev/block/sda1   flags=display="USB-OTG";storage;wipeingui;removable
